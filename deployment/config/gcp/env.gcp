# GCP deployment env. Source locally, or feed to `gcloud run deploy --set-env-vars`.
DEPLOY_PLATFORM=gcp
PROJECT_ID=resilience-riskradar
GOOGLE_CLOUD_PROJECT=resilience-riskradar
GOOGLE_CLOUD_LOCATION=us-central1
REGION=us-central1
AI_PROVIDER=gemini
GOOGLE_GENAI_USE_VERTEXAI=1

# Silver (read) / decisions (write) targets. Defaults match the literals below if
# unset; override SEMANTIC_DS to point at an Option-B virtual Silver dataset.
SEMANTIC_DS=resilience-riskradar.tiger_semantic
DECISIONS_DS=resilience-riskradar.tiger_decisions

# Cloud Run uses the attached service account (ADC) — no key needed.
# Locally, docker-compose mounts a key and sets:
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa-key.json
