# Databricks deployment env. Replace <...> placeholders for the client workspace.
DEPLOY_PLATFORM=databricks
DATABRICKS_HOST=<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse_id>
DATABRICKS_CATALOG=<client_catalog>
# Secret — inject at runtime (Databricks secret / env). Do NOT commit a real token.
# DATABRICKS_TOKEN=<set-via-secret>

# Silver (read) / decisions (write) targets as catalog.schema. The mapped virtual
# views are created under SEMANTIC_DS by tools/run_schema_mapping.py.
SEMANTIC_DS=<client_catalog>.tiger_semantic
DECISIONS_DS=<client_catalog>.tiger_decisions
AI_PROVIDER=gemini
