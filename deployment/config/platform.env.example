# ─────────────────────────────────────────────────────────────────────────────
# Platform selection for the deployment driver (driver.py / driver.sh).
# The driver loads config/<DEPLOY_PLATFORM>/ and exports the resolved Silver
# target so the app + the schema-mapping runner agree on where to read/create.
# ─────────────────────────────────────────────────────────────────────────────
DEPLOY_PLATFORM=gcp          # gcp | databricks | local

# ── Shared (any platform) ────────────────────────────────────────────────────
# Override the Silver (read) / decisions (write) targets. When unset they default
# to <PROJECT_ID>.tiger_semantic / .tiger_decisions (GCP reference). Point
# SEMANTIC_DS at a virtual Silver layer (Option B mapped views) to consume mapped
# client data with no app-code change.
# SEMANTIC_DS=<project_or_catalog>.tiger_semantic
# DECISIONS_DS=<project_or_catalog>.tiger_decisions
AI_PROVIDER=gemini           # legacy label; LLM_PROVIDER below wins if set

# ── LLM provider (model_provider.py) — Gemini default; others via ADK LiteLlm ──
# Requires litellm in the image (installed non-fatally in backend/Dockerfile; see STEPS.md).
# Keys: prod on Cloud Run should use Secret Manager, not plaintext here.
# LLM_PROVIDER=openai                 # gemini (default) | openai | anthropic | azure | …
# OPENAI_API_KEY=sk-...               # or ANTHROPIC_API_KEY=...
# LLM_MODEL_DEFAULT=gpt-4o            # optional global model override
# LLM_MODEL_CUSTOMER_SUPPLY=gpt-4o    # optional per-agent: LLM_MODEL_<AGENT>
# LLM_TEMP_CUSTOMER_SUPPLY=0.2        # optional per-agent temperature

# ── GCP-specific  (full set in config/gcp/env.gcp) ───────────────────────────
# PROJECT_ID, GOOGLE_CLOUD_LOCATION, REGION, GOOGLE_GENAI_USE_VERTEXAI,
# GOOGLE_APPLICATION_CREDENTIALS (local only; Cloud Run uses ADC)

# ── Databricks-specific  (full set in config/databricks/env.databricks) ──────
# DATABRICKS_HOST, DATABRICKS_HTTP_PATH, DATABRICKS_TOKEN (secret), DATABRICKS_CATALOG
